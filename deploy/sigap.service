# Unit systemd tingkat pengguna untuk portal Sigap.
# Portal berjalan di host, bukan di container, karena perlu menjalankan perintah `hermes`
# dan membaca penyimpanan sesi Hermes milik pengguna yang sama.
#
# Pasang:
#   mkdir -p ~/.config/systemd/user && cp deploy/sigap.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now sigap
[Unit]
Description=Sigap, portal seller untuk admin AI WhatsApp
After=network.target

[Service]
WorkingDirectory=%h/sigap
Environment=NODE_ENV=production
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node server/dist/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
