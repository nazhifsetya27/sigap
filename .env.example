# Salin ke .env lalu sesuaikan. Semua baris opsional; nilai di bawah adalah bawaannya.

# Alamat server portal. Biarkan 127.0.0.1 kecuali di belakang reverse proxy.
HOST=127.0.0.1
PORT=4310

# demo   = data contoh yang dibuat portal sendiri (untuk melihat tampilan)
# hermes = data asli dari profil Hermes Agent (Echo, Tally, Ping)
DATA_SOURCE=demo

# Wajib diisi sebelum portal dibuka ke internet. Kosong = tanpa login (hanya untuk lokal).
ACCESS_CODE=

# Nama toko yang tampil di portal.
STORE_NAME=Toko Anda
TIMEZONE=Asia/Jakarta

# --- Hermes Agent (dipakai saat DATA_SOURCE=hermes) ---
HERMES_HOME=~/.hermes
HERMES_BIN=hermes
ECHO_PROFILE=echo
TALLY_PROFILE=tally
PING_PROFILE=ping
# Sumber sesi Hermes yang dihitung sebagai chat pelanggan.
HERMES_SOURCES=whatsapp,whatsapp_cloud

# --- Meteran biaya ---
# Saldo kredit penyedia model dalam USD, dan kurs yang Anda dapat saat top up.
# Contoh: top up Rp20.000 menjadi US$1.09, berarti 20000 / 1.09 = 18349.
CREDIT_USD=1.09
IDR_PER_USD=18349
# Asumsi jumlah percakapan per hari untuk proyeksi "kuat berapa hari".
CHATS_PER_DAY=200
# Tarif per 1 juta token (USD). Dipakai hanya bila Hermes tidak mencatat biaya.
RATE_INPUT=0.15
RATE_CACHED=0.003
RATE_OUTPUT=0.60
PROVIDER_NAME=Fenrir
PROVIDER_MODEL=deepseek/deepseek-v4.1-flash
